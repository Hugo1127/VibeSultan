# =============================================================================
# VibeGamer / Turmoil Agent — 环境变量模板（中文注释版）
# 复制为 env/.env 后填写密钥。以 # 开头的行为注释。
# Agent 加载路径：env/.env（可用 ENV_FILE=... 覆盖）。
# 英文注释版见：env/.env.example
# =============================================================================

# -----------------------------------------------------------------------------
# LLM（OpenAI 兼容 API）
# 文档（Kimi）：https://platform.kimi.com/docs/guide/kimi-k3-quickstart
# 在服务商控制台创建密钥后，设置以下其中一项即可：
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# MOONSHOT_API_KEY=          # 别名，Agent 同样接受
#
# API 基础 URL（末尾斜杠可有可无；Agent 会自动去掉）。
# 下方为国际站默认；中国大陆常用 https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.moonshot.ai/v1
# 对局 / 复盘 / 压缩所用的聊天模型 ID
OPENAI_MODEL=kimi-k3

# 发往 LLM API 与本地游戏 HTTP 的 User-Agent
HTTP_USER_AGENT=VibeGamer-TurmoilAgent/0.1

# LLM HTTP 重试：首次失败后的额外尝试次数
# 对 4xx/5xx（401/403 除外）及瞬时网络错误重试
LLM_MAX_RETRIES=5
# 两次 LLM 重试之间的固定等待（秒）
LLM_RETRY_INTERVAL_SEC=10
# 单次 LLM HTTP 超时（毫秒）。超时后按 LLM_MAX_RETRIES 重试。
# 默认 300s；长压缩或后期对局可能需要更大（如 600000）
LLM_REQUEST_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# 游戏 Observer（BepInEx 插件 HTTP 桥）
# -----------------------------------------------------------------------------
# 本地 Observer 基础 URL
GAME_BASE_URL=http://127.0.0.1:17890
# 每次游戏 HTTP 调用的超时（毫秒）
GAME_REQUEST_TIMEOUT_MS=15000
# 为 true 时，submitActions 仅记日志并返回合成 ok（不真正写游戏）
GAME_DRY_RUN=false

# -----------------------------------------------------------------------------
# 单局 Agent 循环（npm start / npm run dev）
# -----------------------------------------------------------------------------
# 单局最大工具 / LLM 步数；设为 0 时不限制
AGENT_MAX_STEPS=40
# 紧凑状态中省略战争迷雾格子 dump（减小 prompt）
AGENT_STATE_OMIT_FOG_CELLS=true

# 上下文压缩（摘要 + 保留最近若干轮）
# 硬触发：prompt token 数达到该值时开始压缩
AGENT_COMPRESS_TRIGGER_TOKENS=64000
# 软预热：硬触发阈值的比例（0.50 = 50%）
AGENT_COMPRESS_SOFT_RATIO=0.50
# 若 EWMA 增长预测再过这么多轮会触碰硬触发，也提前预热
AGENT_COMPRESS_LOOKAHEAD_TURNS=2
# 压缩后保留最近这么多完整的 assistant+tool 轮次
AGENT_COMPRESS_KEEP_TURNS=4
# 流式压缩每段最大 token（长历史会分块再合并）
AGENT_COMPRESS_SEGMENT_TOKENS=12000
# 压缩重建前 dump 完整 messages.json（调试用）
AGENT_COMPRESS_DUMP=false

# 每局日志目录（默认：agents/turmoil/logs）
# AGENT_LOG_DIR=
# 每条记入日志的 LLM/工具 blob 最大字符数
AGENT_LOG_MAX_CHARS=8000

# -----------------------------------------------------------------------------
# Autoplay 多局学习（npm run autoplay）
# 会话参数：--fresh | --memory <id> | --list | --seed <10 位数字>
# AGENT_MEMORY_SESSION=my-exp   # 非交互续跑
# -----------------------------------------------------------------------------

# 完成 N 局后停止；0 = 无限（直到 Ctrl+C）
AGENT_MAX_GAMES=0
# 实验墙钟时限（小时）；0 = 不限时
AGENT_TIME_BUDGET_HOURS=0

# memory/sessions/<id>/ 的父目录
# AGENT_MEMORY_DIR=

# 仅宿主侧持有的留出种子，用于泛化评估（逗号分隔的 10 位数字）。
# 结果写入 hidden-evals.jsonl，且绝不可注入 Agent prompt。
# 留空则禁用 hidden eval 调度（即使 ENABLED=true）。
# AGENT_HIDDEN_SEEDS=0123456789,1111111111,2222222222
# 策略晋升时可选的筛选种子列表（逗号分隔）
# AGENT_SELECTION_SEEDS=
# 每完成 N 局学习（explore/validate/tip）后跑一次仅 playbook 的 hidden_eval
AGENT_HIDDEN_EVAL_EVERY_N=5
# 宿主侧 hidden evaluation 总开关
AGENT_HIDDEN_EVAL_ENABLED=true

# 菜单 → 油田启动等待（毫秒）
AGENT_BOOT_TIMEOUT_MS=60000
# Autoplay 局间暂停（毫秒）
AGENT_INTER_GAME_DELAY_MS=2000
# 注入的 playbook / 假设文本最大字符数
AGENT_HYPOTHESIS_BUDGET_CHARS=6000

# Tip 验证批次（A/B/C 经济）
# 单批 tip 允许的预期利润回撤比例上限（0.1 = 10%）
AGENT_TIP_RISK_BUDGET_RATIO=0.1
# Tip 验证局注入的硬性现金下限
AGENT_TIP_MINIMUM_CASH=100
# 规划 tip_validate 批次所需的最少本地 tip 数（1 = 利于冷启动）
AGENT_TIP_MIN_LOCAL_TIPS=1

# 公平调度：连续 tip 局达到 N 后，让出给待处理的假设工作
AGENT_SCHED_FAIRNESS=true
AGENT_SCHED_TIP_GAMES_BEFORE_HYPOTHESIS=3

# 反作弊失败后允许重写假设一次
AGENT_ANTICHEAT_REWRITE_ONCE=true
# LLM 思考时暂停游戏时钟；执行对局动作后再恢复
AGENT_AUTO_PAUSE=true
# 入队 plan wait/* 后，游戏继续运行直到 planQueue 排空（超时毫秒）
AGENT_PLAN_WAIT_TIMEOUT_MS=180000
AGENT_PLAN_WAIT_POLL_MS=400

# 提示：Autoplay 下完整单人局可将 AGENT_MAX_STEPS 调高（如 200）。

# -----------------------------------------------------------------------------
# 离线 Skill Optimizer（P2）— npm run skillopt:offline -- --memory <id>
# 对齐 SkillOpt：harvest → minibatch reflect → 有界编辑 → gate。
# 不在每局在线对局内运行；在足够局数后或会话结束时手动跑。
# -----------------------------------------------------------------------------

# 为 true 时，explore/hidden_eval 若存在则注入 skills/best_skill.md
# （缺失时回退到完整假设账本）
AGENT_SKILLOPT_INJECT_BEST=true
# 与 best_skill 一并附加的活跃 tip 上限（控制 prompt 体积）
AGENT_SKILLOPT_MAX_TIPS_WITH_SKILL=2

# 触发：距上次优化已过这么多局后，才有资格再跑一步（类 SkillOpt 批节奏）
AGENT_SKILLOPT_TRIGGER_GAMES=20
# 触发：至少需要这么多失败/不确定/放弃轨迹（否则跳过 patch）
AGENT_SKILLOPT_MIN_FAILURES=6
# 每步优化最多采集的轨迹数（≈ SkillOpt train.batch_size）
AGENT_SKILLOPT_BATCH_SIZE=40
# 每组 reflect 的轨迹数 M（≈ SkillOpt gradient.minibatch_size）
AGENT_SKILLOPT_MINIBATCH_SIZE=8
# 每步优化最多编辑次数 L（≈ SkillOpt learning_rate / 编辑预算）
AGENT_SKILLOPT_EDIT_BUDGET=4
# best_skill.md 软上限（字符；约 2000 token ≈ 8000 字符）
AGENT_SKILLOPT_MAX_CHARS=8000
# 晋升时允许的 hidden 平均利润相对回撤上限（0.05 = 5%）
AGENT_SKILLOPT_HIDDEN_REGRESSION_MAX=0.05
# 仅对失败轨迹做 reflect（跳过成功轨迹），对应 SkillOpt failure_only
AGENT_SKILLOPT_FAILURE_ONLY=true

# -----------------------------------------------------------------------------
# 终端学习曲线图（每局 autoplay 结束后）
# 使用 asciichart：S_train（训练集迄今最佳）、S_hidden（hidden 迄今最佳）、
# 以及每局利润。设 AGENT_TERMINAL_CURVE=false 可关闭输出。
# -----------------------------------------------------------------------------
AGENT_TERMINAL_CURVE=true
AGENT_TERMINAL_CURVE_WIDTH=48
AGENT_TERMINAL_CURVE_HEIGHT=8

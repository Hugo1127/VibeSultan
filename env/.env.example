# =============================================================================
# VibeSultan / Sultan Agent — environment template
# Copy to env/.env and fill secrets. Lines starting with # are comments.
# Agent loads: env/.env (or ENV_FILE=... override).
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible API)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# MOONSHOT_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_MODEL=kimi-k3

HTTP_USER_AGENT=VibeSultan-SultanAgent/0.1

LLM_MAX_RETRIES=5
LLM_RETRY_INTERVAL_SEC=10
LLM_REQUEST_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Game Observer (BepInEx IL2CPP plugin HTTP bridge)
# -----------------------------------------------------------------------------
GAME_BASE_URL=http://127.0.0.1:17890
GAME_REQUEST_TIMEOUT_MS=15000
GAME_DRY_RUN=false

# -----------------------------------------------------------------------------
# Single-run agent loop (npm start / npm run dev)
# -----------------------------------------------------------------------------
# Set to 0 for no step limit.
AGENT_MAX_STEPS=40

AGENT_COMPRESS_TRIGGER_TOKENS=64000
AGENT_COMPRESS_SOFT_RATIO=0.50
AGENT_COMPRESS_LOOKAHEAD_TURNS=2
AGENT_COMPRESS_KEEP_TURNS=4
AGENT_COMPRESS_SEGMENT_TOKENS=12000
AGENT_COMPRESS_DUMP=false

# AGENT_LOG_DIR=
AGENT_LOG_MAX_CHARS=8000

# -----------------------------------------------------------------------------
# Autoplay multi-game learning (npm run autoplay)
# Session flags: --fresh | --memory <id> | --list
# -----------------------------------------------------------------------------
AGENT_MAX_GAMES=0
AGENT_TIME_BUDGET_HOURS=0
# AGENT_MEMORY_DIR=
AGENT_BOOT_TIMEOUT_MS=60000
AGENT_INTER_GAME_DELAY_MS=2000
# In-run daily review cadence (game days). Keep 1 for ~60-day Sultan runs:
# every day writes experiences + day-evidence; hypotheses are lightly settled/deduped.
AGENT_REVIEW_INTERVAL_DAYS=1
AGENT_HYPOTHESIS_BUDGET_CHARS=6000
# Relevant card/event memory injected for the current hand and map only.
AGENT_ENTITY_MEMORY_BUDGET_CHARS=2500
AGENT_ENTITY_MIN_SAMPLES=3
AGENT_ENTITY_MAX_CARDS=6
AGENT_ENTITY_MAX_EVENTS=4
AGENT_ENTITY_MAX_INTERACTIONS=8
# Async entity soft-fact enrichment (does not block gameplay).
AGENT_ENTITY_ENRICH_ENABLED=true
AGENT_ENTITY_ENRICH_CONCURRENCY=1
AGENT_ENTITY_ENRICH_MAX_QUEUE=200
AGENT_ENTITY_ENRICH_TIMEOUT_MS=60000
AGENT_ENTITY_ENRICH_MAX_ATTEMPTS=2
AGENT_ENTITY_ENRICH_FLUSH_TIMEOUT_MS=5000
AGENT_EPISODE_TTL_STEPS=120
# Moral Alignment / Social Capital (scorer dim, axiom, altruism pending settlement).
# Set false/0/off to use legacy short-horizon scoring and immediate choice outcomes.
AGENT_SOCIAL_CAPITAL_ENABLED=true
# Inject skills/best_skill.md when present (cross-game slow loop).
AGENT_SKILLOPT_INJECT_BEST=true
AGENT_SKILLOPT_MAX_CHARS=4000

AGENT_TIP_RISK_BUDGET_RATIO=0.1
AGENT_TIP_MIN_LOCAL_TIPS=1
AGENT_SCHED_FAIRNESS=true
AGENT_SCHED_TIP_GAMES_BEFORE_HYPOTHESIS=3

AGENT_TERMINAL_CURVE=true
AGENT_TERMINAL_CURVE_WIDTH=48
AGENT_TERMINAL_CURVE_HEIGHT=8
